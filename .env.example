# Copy this file to ".env" (same folder) and edit the values.
# The ".env" file is git-ignored and must never be shared.

# SQLite database file. The path is relative to the prisma/ folder,
# so this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to run in DEMO MODE (deterministic keyword-based analysis).
GEMINI_API_KEY=""

# Gemini model used for complaint analysis. Check
# https://ai.google.dev/gemini-api/docs/models for currently supported names.
GEMINI_MODEL="gemini-3.8-flash"

# Passcode that protects the admin dashboard, tickets, insights and admin APIs.
# Use a long, hard-to-guess value and keep it only in .env (never commit it).
# If left empty: admin is OPEN while developing and DISABLED in production.
ADMIN_PASSCODE=""

# Similarity score (0.1 - 1.0) at or above which a new complaint is linked
# to an existing open complaint as a likely duplicate.
DUPLICATE_THRESHOLD="0.55"
